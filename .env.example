# Import foto da Google Drive (opzionale — Fase 2).
# Copia questo file in ".env" e inserisci i tuoi valori dalla Google Cloud Console.
# Finché non sono impostati, l'opzione "Da Google Drive" resta disabilitata;
# fotocamera e galleria funzionano comunque.

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
